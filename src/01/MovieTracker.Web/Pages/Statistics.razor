@page "/statistics"

<PageTitle>Statistics</PageTitle>

<section class="page-header page-section"><span class="eyebrow">YOUR YEAR IN FILM</span><h1>Viewing statistics</h1><p>Demo insights into your movie habits.</p><DemoFeatureNotice /></section>
<section class="metric-grid page-section">
    <article><span>Movies watched</span><strong>42</strong><small>↑ 12% from last month</small></article>
    <article><span>Average rating</span><strong>7.8</strong><small>Out of 10</small></article>
    <article><span>Favourite genre</span><strong class="metric-text">Science Fiction</strong><small>14 movies watched</small></article>
    <article><span>This month</span><strong>6</strong><small>18 hours on screen</small></article>
</section>
<section class="page-section chart-panel"><div class="section-heading"><h2>Genres watched</h2><span>Demo distribution</span></div>
    <div class="bar-row"><span>Science Fiction</span><div><i style="width: 82%"></i></div><b>14</b></div>
    <div class="bar-row"><span>Drama</span><div><i style="width: 59%"></i></div><b>10</b></div>
    <div class="bar-row"><span>Thriller</span><div><i style="width: 41%"></i></div><b>7</b></div>
    <div class="bar-row"><span>Comedy</span><div><i style="width: 29%"></i></div><b>5</b></div>
</section>

